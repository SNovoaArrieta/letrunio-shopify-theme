<section class="section funnel-problem">
  <div class="page-width problem-grid">
    <div class="problem-heading">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="problem-lead">{{ section.settings.text }}</div>
    </div>

    <div class="problem-list">
      {% for block in section.blocks %}
        <article class="problem-item" {{ block.shopify_attributes }}>
          <span class="problem-mark" aria-hidden="true">{{ forloop.index }}</span>
          <div>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problema y solución",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "SIEMPRE TERMINAN HACIENDO LO MISMO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "No les falta tiempo juntos. Les faltan ideas que se sientan diferentes." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuando todos los planes acaban en “vemos una película y ya”, hasta una noche libre puede sentirse igual a las demás. Este ebook les da el punto de partida para cambiar eso.</p>" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Situación",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "No saben qué hacer" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Tienen ganas de compartir, pero ninguna idea concreta." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problema y solución",
      "blocks": [
        {"type":"point","settings":{"heading":"Quieren hacer algo diferente","text":"Pero pensar el plan desde cero termina quitándoles las ganas."}},
        {"type":"point","settings":{"heading":"No quieren gastar demasiado","text":"Buscan una experiencia especial que también sea posible en casa."}},
        {"type":"point","settings":{"heading":"Necesitan volver a conectar","text":"Sin pantallas de por medio y sin convertirlo en otra obligación."}}
      ]
    }
  ]
}
{% endschema %}
