<section class="section">
  <div class="page-width product-page">
    <div class="product-gallery">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', loading: 'eager', alt: product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="product-info">
      <p class="eyebrow">EBOOK DIGITAL</p>
      <h1>{{ product.title }}</h1>
      <div class="product-price">{{ product.price | money }}</div>
      <div class="product-description">{{ product.description }}</div>

      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="button button--wide" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Agregar al carrito{% else %}No disponible{% endif %}
        </button>
        {{ form | payment_button }}
      {% endform %}

      <div class="trust-list">
        <span>✓ Compra segura</span>
        <span>✓ Producto 100% digital</span>
        <span>✓ Acceso por correo después del pago</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Producto principal", "settings": [] }
{% endschema %}
