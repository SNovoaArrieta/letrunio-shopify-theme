<section class="section cart-page">
  <div class="page-width">
    <p class="eyebrow">TU SELECCIÓN</p>
    <h1>Carrito</h1>

    {% if cart.item_count == 0 %}
      <div class="richtext">
        <p>Tu carrito está vacío.</p>
        <p><a class="button" href="{{ routes.root_url }}">Explorar Letrunio</a></p>
      </div>
    {% else %}
      {% form 'cart', cart %}
        <div class="cart-items">
          {% for item in cart.items %}
            <article class="cart-item">
              {% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.product.title }}{% endif %}
              <div>
                <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                <p>{{ item.final_line_price | money }}</p>
                <a href="{{ item.url_to_remove }}">Eliminar</a>
              </div>
              <label>
                <span class="visually-hidden">Cantidad</span>
                <input class="quantity-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </label>
            </article>
          {% endfor %}
        </div>
        <div class="cart-summary">
          <p class="total">Total: {{ cart.total_price | money }}</p>
          <button class="button button--secondary" type="submit" name="update">Actualizar</button>
          <button class="button" type="submit" name="checkout">Finalizar compra</button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Carrito principal", "settings": [] }
{% endschema %}
