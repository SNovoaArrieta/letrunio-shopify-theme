<section class="section section--soft">
  <div class="page-width">
    <div class="section-heading">
      <p class="eyebrow">COLECCIÓN LETRUNIO</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="richtext">{{ collection.description }}</div>{% endif %}
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="collection-grid">
        {% for product in collection.products %}
          <article class="product-card">
            <a href="{{ product.url }}">
              <div class="product-card-media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 800 | image_tag: widths: '360, 540, 800', loading: 'lazy', alt: product.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="product-card-copy">
                <h2>{{ product.title }}</h2>
                <p class="product-card-price">{{ product.price | money }}</p>
              </div>
            </a>
          </article>
        {% else %}
          <p>Muy pronto encontrarás nuevos ebooks en esta colección.</p>
        {% endfor %}
      </div>
      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Colección principal",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 3, "max": 24, "step": 3, "label": "Productos por página", "default": 12 }
  ]
}
{% endschema %}
