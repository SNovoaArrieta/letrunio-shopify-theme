{% assign featured_product = section.settings.product %}
{% assign featured_image = section.settings.image %}

<section id="comprar" class="hero">
  <div class="page-width hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="lead">{{ section.settings.text }}</div>
      <div class="hero-meta">
        {% for block in section.blocks %}
          <span class="pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endfor %}
      </div>

      <div class="hero-price-wrap">
        <span>Pago único</span>
        <div class="hero-price">
        {% if featured_product != blank %}
          {{ featured_product.price | money }}
        {% else %}
          {{ section.settings.fallback_price }}
        {% endif %}
        </div>
      </div>

      <div class="hero-actions">
        {% if featured_product != blank %}
          {% form 'product', featured_product, class: 'hero-product-form' %}
            <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
            <button class="button" type="submit" name="add" {% unless featured_product.available %}disabled{% endunless %}>
              {% if featured_product.available %}Comprar ahora{% else %}Agotado{% endif %}
            </button>
            {{ form | payment_button }}
          {% endform %}
          <a class="hero-details-link" href="#contenido">Ver qué incluye ↓</a>
        {% else %}
          <a class="button" href="{{ section.settings.cta_link | default: '#oferta' }}">{{ section.settings.cta_label }}</a>
          <a class="hero-details-link" href="#contenido">Ver qué incluye ↓</a>
        {% endif %}
      </div>
      <p class="hero-purchase-note">Ebook digital · Acceso por correo · Disponible inmediatamente después del pago</p>
    </div>

    <div class="hero-visual" aria-label="Portada de Una noche para dos">
      <div class="product-cover">
        {% if featured_image != blank %}
          {{ featured_image | image_url: width: 900 | image_tag: widths: '420, 640, 900', loading: 'eager', alt: section.settings.heading }}
        {% else %}
          <img src="{{ 'ebook-mockup.webp' | asset_url }}" width="1145" height="1374" loading="eager" alt="Una noche para dos — ebook digital con 30 citas en casa">
        {% endif %}
      </div>
      <div class="floating-note">{{ section.settings.note }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada del producto",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto destacado" },
    { "type": "image_picker", "id": "image", "label": "Portada alternativa" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "EL PLAN PARA HOY YA ESTÁ LISTO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "30 citas en casa para dejar de hacer siempre lo mismo" },
    { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Elijan una idea, preparen lo necesario y conviertan una noche cualquiera en tiempo que sí se disfruta juntos.</p>" },
    { "type": "text", "id": "fallback_price", "label": "Precio mientras eliges el producto", "default": "US$9,90" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Comprar el ebook — US$9,90" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" },
    { "type": "text", "id": "note", "label": "Nota flotante", "default": "30 planes. Cero excusas para repetir siempre lo mismo." }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Etiqueta",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Descarga digital" }]
    }
  ],
  "presets": [
    {
      "name": "Portada del producto",
      "blocks": [{"type":"tag"},{"type":"tag","settings":{"text":"30 ideas"}},{"type":"tag","settings":{"text":"Para hacer en casa"}}]
    }
  ]
}
{% endschema %}
