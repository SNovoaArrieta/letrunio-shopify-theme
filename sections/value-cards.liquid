<section id="contenido" class="section section--soft">
  <div class="page-width">
    <div class="section-heading">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="value-grid">
      {% for block in section.blocks %}
        <article class="value-card" {{ block.shopify_attributes }}>
          <span class="value-number">{{ block.settings.number }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenido del ebook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "QUÉ ENCONTRARÁS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo listo para dejar de decir “¿y hoy qué hacemos?”" },
    { "type": "textarea", "id": "text", "label": "Descripción", "default": "Elige una idea, prepara lo necesario y concéntrate en disfrutar." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "01" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Una idea clara" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Cada cita incluye una propuesta concreta para que no tengas que improvisar." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contenido del ebook",
      "blocks": [
        {"type":"card","settings":{"number":"30","heading":"Citas diferentes","text":"Ideas variadas para noches tranquilas, creativas, divertidas o especiales."}},
        {"type":"card","settings":{"number":"01","heading":"Guía fácil de seguir","text":"Cada plan explica qué preparar y cómo convertirlo en una experiencia completa."}},
        {"type":"card","settings":{"number":"∞","heading":"Momentos para ustedes","text":"Opciones que se pueden adaptar a sus gustos, espacio y presupuesto."}}
      ]
    }
  ]
}
{% endschema %}
