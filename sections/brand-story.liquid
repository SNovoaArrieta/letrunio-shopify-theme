<section class="section section--dark">
  <div class="page-width brand-story">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="brand-story-copy">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Historia de Letrunio",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "LETRUNIO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Ideas que puedes poner en práctica" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Creamos ebooks claros, útiles y bonitos para transformar una buena idea en algo que realmente puedas hacer.</p><p>Hoy empezamos con planes para compartir en pareja. Después vendrán nuevas colecciones para aprender, crear y disfrutar.</p>" }
  ],
  "presets": [{ "name": "Historia de Letrunio" }]
}
{% endschema %}
