<footer class="site-footer">
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand brand--logo brand--footer" href="{{ routes.root_url }}" aria-label="Letrunio — Inicio">
          {% render 'letrunio-brand' %}
        </a>
        <p>{{ section.settings.description }}</p>
      </div>
      <div>
        <p class="footer-title">Explora</p>
        <nav class="footer-links" aria-label="Enlaces del pie">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      </div>
      <div>
        <p class="footer-title">Síguenos</p>
        <div class="footer-links">
          {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        </div>
      </div>
    </div>
    <div class="footer-bottom">© {{ 'now' | date: '%Y' }} Letrunio. Todos los derechos reservados.</div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Ideas claras y útiles para aprender, crear y disfrutar más." },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" }
  ]
}
{% endschema %}
